{{!
    @template mod_edpreset/manage_page

    Preset activity management page.

    Context variables required for this template:
    * configured - Whether a template course is set and still exists
    * enabled - Whether the plugin is switched on
    * settingsurl - The plugin's settings page
    * templatecoursename - Name of the template course
    * templatecourseurl - Link to the template course
    * manageurl - This page
    * sesskey - Session key for the action buttons
    * haspresets - Whether there is anything to list
    * releasedcount - How many presets are released to teachers
    * totalcount - How many presets exist
    * presets - Array of preset rows
    * hassuggestions - Whether there are uncovered date fields to report
    * suggestions - Array of {modname, fields}

    Example context (json):
    {
        "configured": true,
        "enabled": true,
        "settingsurl": "#",
        "templatecoursename": "Activity templates",
        "templatecourseurl": "#",
        "manageurl": "#",
        "sesskey": "abc123",
        "haspresets": true,
        "releasedcount": 1,
        "totalcount": 1,
        "presets": [
            {
                "id": 1,
                "title": "Reflective journal",
                "modulename": "Assignment",
                "modname": "assign",
                "category": "Formative assessment",
                "sectionnum": 1,
                "status": "released",
                "statuslabel": "Released",
                "statusclass": "success",
                "inchooser": true,
                "datefields": "allowsubmissionsfromdate, cutoffdate, duedate, gradingduedate",
                "haserror": true,
                "lasterror": "moodle_exception: The exemplar activity for this preset no longer exists.",
                "lasterrortime": "1 Jan 2026, 09:30"
            }
        ],
        "hassuggestions": false,
        "suggestions": []
    }
}}
{{#configured}}
    <p>
        {{#str}} manage:templateis, mod_edpreset {{/str}}
        <a href="{{templatecourseurl}}">{{templatecoursename}}</a>.
        {{#str}} manage:sectionzeroignored, mod_edpreset {{/str}}
    </p>
{{/configured}}
{{^configured}}
    <div class="alert alert-warning" role="alert">
        {{#str}} manage:notconfigured, mod_edpreset {{/str}}
        <a href="{{settingsurl}}">{{#str}} manage:gotosettings, mod_edpreset {{/str}}</a>
    </div>
{{/configured}}

{{#configured}}
    <div class="mb-3">
        <form method="post" action="{{manageurl}}" class="d-inline-block mr-2">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="rebuild">
            <button type="submit" class="btn btn-secondary">
                {{#str}} manage:rebuild, mod_edpreset {{/str}}
            </button>
        </form>
        <p class="text-muted small mt-2 mb-0">
            {{#str}} manage:rebuild_help, mod_edpreset {{/str}}
        </p>
    </div>

    <p>
        {{#str}} manage:offeredcount, mod_edpreset, {"released": "{{releasedcount}}", "total": "{{totalcount}}"} {{/str}}
    </p>
{{/configured}}

{{#haspresets}}
    <div class="table-responsive">
        <table class="table table-sm generaltable">
            <caption class="sr-only">{{#str}} manage:tablecaption, mod_edpreset {{/str}}</caption>
            <thead>
                <tr>
                    <th scope="col">{{#str}} manage:col:preset, mod_edpreset {{/str}}</th>
                    <th scope="col">{{#str}} manage:col:type, mod_edpreset {{/str}}</th>
                    <th scope="col">{{#str}} manage:col:category, mod_edpreset {{/str}}</th>
                    <th scope="col">{{#str}} manage:col:status, mod_edpreset {{/str}}</th>
                    <th scope="col">{{#str}} manage:col:inchooser, mod_edpreset {{/str}}</th>
                    <th scope="col">{{#str}} manage:col:dates, mod_edpreset {{/str}}</th>
                    <th scope="col">{{#str}} manage:col:lasterror, mod_edpreset {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#presets}}
                    <tr>
                        <th scope="row" class="font-weight-normal">{{title}}</th>
                        <td>{{modulename}}</td>
                        <td>{{category}}</td>
                        <td><span class="badge badge-{{statusclass}}">{{statuslabel}}</span></td>
                        <td>{{#inchooser}}{{#str}} yes {{/str}}{{/inchooser}}{{^inchooser}}{{#str}} no {{/str}}{{/inchooser}}</td>
                        <td class="small">{{datefields}}</td>
                        <td class="small">
                            {{#haserror}}
                                <div class="text-danger">{{lasterror}}</div>
                                <div class="text-muted">{{lasterrortime}}</div>
                            {{/haserror}}
                        </td>
                    </tr>
                {{/presets}}
            </tbody>
        </table>
    </div>
{{/haspresets}}

{{#configured}}
    {{^haspresets}}
        <div class="alert alert-info" role="alert">
            {{#str}} manage:nopresets, mod_edpreset {{/str}}
        </div>
    {{/haspresets}}
{{/configured}}

{{#hassuggestions}}
    <h3>{{#str}} manage:suggestionsheading, mod_edpreset {{/str}}</h3>
    <p>{{#str}} manage:suggestionsintro, mod_edpreset {{/str}}</p>
    <ul>
        {{#suggestions}}
            <li><code>{{modname}}</code>: {{fields}}</li>
        {{/suggestions}}
    </ul>
{{/hassuggestions}}
