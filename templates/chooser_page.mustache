{{!
    @template mod_edpreset/chooser_page

    The preset activities a teacher can browse, filter and add to their course.

    Everything the in-page filter needs is baked onto each card as a data attribute, so filtering
    never talks to the server. Adding is an ordinary form post to copy.php, which restores whatever
    was asked for and returns to the course section: each card's own button is a link carrying one
    preset id, and the sticky footer submits however many are selected. mod_edpreset/chooser only
    keeps the hidden presets field in step with the selection.

    The toolbar sits outside the form on purpose, so that pressing Enter in the search box filters
    rather than submitting the selection.

    Context variables required for this template:
    * courseid int - the course presets are being added to
    * sectionnum int - the section they will be added to
    * beforemod int - course module id to insert before, or 0
    * copyurl string - where the selection is posted
    * sesskey string
    * hasgroups bool
    * groups array - name, key, count, expanded, starred, cards
    * alltags array - name
    * hastags bool

    Example context (json):
    {
        "courseid": 12,
        "sectionnum": 2,
        "beforemod": 0,
        "copyurl": "https://moodle.local/mod/edpreset/copy.php",
        "sesskey": "abc123",
        "hasgroups": true,
        "hastags": true,
        "alltags": [{"name": "Assessment"}],
        "groups": [
            {
                "name": "Assessment",
                "key": "1a2b3c4d",
                "count": 1,
                "expanded": true,
                "starred": false,
                "cards": [
                    {
                        "presetid": 7,
                        "title": "Reflective journal",
                        "description": "<p>Use this for a weekly reflection.</p>",
                        "icon": "<img src='#' alt=''>",
                        "modname": "assign",
                        "modfullname": "Assignment",
                        "purpose": "assessment",
                        "branded": false,
                        "favourited": false,
                        "addurl": "https://moodle.local/mod/edpreset/copy.php?presets=7",
                        "searchtext": "reflective journal assessment",
                        "tagkeys": "assessment",
                        "hastags": true,
                        "tags": [{"name": "Assessment"}]
                    }
                ]
            }
        ]
    }
}}
<div class="edpreset-chooser" data-region="edpreset-chooser">
    {{#hasgroups}}
        <div class="edpreset-toolbar mb-3">
            <div class="mb-2">
                {{< core/search_input_auto }}
                    {{$label}}{{#str}} chooser:search, mod_edpreset {{/str}}{{/label}}
                    {{$placeholder}}{{#str}} chooser:searchplaceholder, mod_edpreset {{/str}}{{/placeholder}}
                {{/ core/search_input_auto }}
            </div>

            {{#hastags}}
                <div class="edpreset-tagbar" data-region="tagbar">
                    <span class="edpreset-tagbar-label">{{#str}} chooser:tagsheading, mod_edpreset {{/str}}</span>
                    {{#alltags}}
                        <button type="button"
                                class="edpreset-tag"
                                data-action="tag"
                                data-tag="{{name}}"
                                aria-pressed="false"
                                aria-label="{{#str}} chooser:filterbytag, mod_edpreset, {{name}} {{/str}}"
                        >{{name}}</button>
                    {{/alltags}}
                </div>
            {{/hastags}}
        </div>

        <div class="edpreset-noresults alert alert-info d-none" data-region="noresults" role="status">
            {{#str}} chooser:noresults, mod_edpreset {{/str}}
        </div>

        <form method="post" action="{{copyurl}}" data-region="addform">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="course" value="{{courseid}}">
            <input type="hidden" name="section" value="{{sectionnum}}">
            <input type="hidden" name="beforemod" value="{{beforemod}}">
            {{! Filled in by mod_edpreset/chooser as cards are selected. Without JavaScript nothing
                ever selects a card, so the footer button stays disabled and only the per-card
                links work. }}
            <input type="hidden" name="presets" value="" data-region="presets">

            <div class="edpreset-groups" data-region="groups">
                {{#groups}}
                    <div class="card mb-2 edpreset-group" data-region="group" data-groupkey="{{key}}">
                        <div class="card-header p-0">
                            {{! No data-parent: a filter has to be able to open several groups at once. }}
                            <a class="btn btn-link btn-block text-start d-flex align-items-center p-2 icons-collapse-expand {{^expanded}}collapsed{{/expanded}}"
                               data-toggle="collapse"
                               data-action="togglegroup"
                               href="#edpreset-group-{{key}}-{{uniqid}}"
                               role="button"
                               aria-expanded="{{#expanded}}true{{/expanded}}{{^expanded}}false{{/expanded}}"
                               aria-controls="edpreset-group-{{key}}-{{uniqid}}"
                            >
                                <span class="expanded-icon icon-no-margin p-1" title="{{#str}} chooser:collapsesection, mod_edpreset, {{name}} {{/str}}">
                                    {{#pix}} t/expandedchevron, core {{/pix}}
                                </span>
                                <span class="collapsed-icon icon-no-margin p-1" title="{{#str}} chooser:expandsection, mod_edpreset, {{name}} {{/str}}">
                                    <span class="dir-rtl-hide">{{#pix}} t/collapsedchevron, core {{/pix}}</span>
                                    <span class="dir-ltr-hide">{{#pix}} t/collapsedchevron_rtl, core {{/pix}}</span>
                                </span>
                                {{#starred}}<span class="edpreset-group-star me-1">{{#pix}} i/star, core {{/pix}}</span>{{/starred}}
                                <span class="edpreset-group-name h5 mb-0">{{name}}</span>
                                <span class="edpreset-tag ms-2" data-region="groupcount" aria-hidden="true">{{count}}</span>
                            </a>
                        </div>
                        <div id="edpreset-group-{{key}}-{{uniqid}}" class="collapse {{#expanded}}show{{/expanded}}">
                            <div class="card-body edpreset-cards">
                                {{#cards}}
                                    {{> mod_edpreset/chooser_card }}
                                {{/cards}}
                            </div>
                        </div>
                    </div>
                {{/groups}}
            </div>

            {{< core/sticky_footer }}
                {{$stickyclasses}} justify-content-between {{/stickyclasses}}
                {{$stickycontent}}
                    <button type="button"
                            class="btn btn-secondary"
                            data-action="clearfilters"
                            disabled
                    >{{#str}} chooser:clearfilters, mod_edpreset {{/str}}</button>
                    <button type="submit"
                            class="btn btn-primary"
                            data-action="addselected"
                            disabled
                    >{{#str}} chooser:addselectednone, mod_edpreset {{/str}}</button>
                {{/stickycontent}}
            {{/ core/sticky_footer }}
        </form>
    {{/hasgroups}}

    {{^hasgroups}}
        <div class="alert alert-info">{{#str}} chooser:nopresets, mod_edpreset {{/str}}</div>
    {{/hasgroups}}
</div>
{{#js}}
require(['mod_edpreset/chooser'], function(chooser) {
    chooser.init();
});
{{/js}}
